# ---- 运行时数据（含会话DB）----
data/console.db
data/console.db-wal
data/console.db-shm
data/*.db
data/*.sqlite*

# ---- 隔离会话的 worktree 物理目录（linked worktree，不应进主仓库）----
data/worktrees/

# ---- 数据库备份（大体积二进制，不入库）----
data/backups/
data/agent_console.db
data/job_logs/
# 本机运行密钥：由 start_dual.py 以 0600 权限读取/生成，绝不入库。
data/.secrets/
data/notify_secret
data/.lock

# ---- 私钥/证书（run.sh 会自动生成）----
data/certs/
*.key
*.crt
*.pem

# ---- 日志与临时产物 ----
*.log
_mt.log
_models.out
*.out

# ---- 上传文件 ----
.console_uploads/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# ---- 编辑器/系统 ----
.DS_Store
*.swp

# ---- Claude 本地配置 ----
.claude/settings.local.json

# ---- graphify 缓存（AST/语义缓存，纯可重新生成，不入库；graph.json/wiki 等产物仍跟踪）----
graphify-out/cache/
